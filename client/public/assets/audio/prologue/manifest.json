5,0.017,0.016,0.019,0.006,0.0,0.0,0.003,0.0],"text":"We'll file the missing person case \u00e2\u20ac\u201d but I can't give you any guarantee."},"station_end-1":{"url":"/assets/audio/voices/f309f897-d82d21d986.mp3","duration":4.13,"speaker":"narrator","envelope":[0.368,1,1,0.879,0.845,0.319,0.106,0.284,0.87,1,0.957,0.869,0.814,0.815,0.591,0.104,0.003,0.0,0.0,0.0,0.003,0.868,1,0.512,0.772,0.997,0.816,0.655,0.327,0.07,0.65,0.929,0.851,0.692,0.543,0.501,0.364,0.143,0.017,0.002,0.001,0.0,0.0,0.0,0.005,0.945,1,1,1,0.797,0.672,0.535,0.699,0.47,0.221,0.209,1,0.828,0.686,0.326,0.315,0.83,0.841,0.793,0.823,0.504,0.561,1,0.885,0.737,0.244,0.099,0.674,0.472,0.343,0.245,0.127,0.025,0.002,0.0,0.0,0.001,0.0],"text":"No clue. A dead end. They leave the station with nothing."},"room_beep-0":{"url":"/assets/audio/voices/8169892a-adae111f4d.mp3","duration":8.863,"speaker":"narrator","envelope":[0.023,0.194,1,1,1,1,0.869,0.841,0.77,0.733,0.555,0.78,0.903,0.817,0.787,0.414,0.195,0.791,1,0.86,0.852,0.809,0.798,0.697,0.276,0.207,0.107,0.208,1,0.935,0.596,0.411,0.21,0.183,0.05,0.054,0.013,0.001,0.001,0.001,0.001,0.0,0.0,0.036,0.337,1,0.99,0.802,0.837,0.817,0.673,0.843,0.961,0.825,0.75,0.126,0.043,0.88,0.972,0.694,0.818,0.816,0.701,0.544,0.197,0.021,0.004,0.001,0.0,0.001,1,1,1,0.634,0.06,0.521,0.924,0.821,0.853,0.771,0.554,0.872,0.858,0.634,0.341,0.805,0.095,0.17,1,1,0.431,0.029,0.032,0.031,0.006,0.001,0.001,0.002,0.002,0.001,0.0,0.006,0.447,1,0.782,0.545,0.07,0.672,0.946,0.699,1,0.992,0.842,0.99,0.632,0.907,0.738,0.508,0.167,0.161,0.893,0.351,0.245,0.243,1,0.999,0.637,0.065,0.041,0.693,1,0.816,0.253,0.161,1,0.875,0.218,0.69,0.976,0.485,0.111,0.937,0.736,0.239,0.191,0.144,0.973,1,0.881,0.863,0.807,0.711,0.702,0.754,0.756,0.488,0.195,0.036,0.005,0.0,0.0,0.005,0.848,0.916,0.432,0.676,0.943,0.615,0.297,0.052,0.019,0.046,0.009,0.0,0.0,0.0,0.001,0.0],"text":"Sameer goes home stressed. Cold leftovers, no energy to cook. Just as he's about to sleep \u00e2\u20ac\u201d a beep."},"room_beep-1":{"url