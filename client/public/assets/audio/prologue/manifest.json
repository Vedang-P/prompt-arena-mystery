0.007,0.006,0.003,0.001],"speechHash":"e9bf77702fd536014265907e433625352c6638953da15ac69083d2a77d0156fd","text":"Look where his thoughts rest,"},"room_voicenote-3":{"url":"/assets/audio/voices/7dcf4caf-c8110fd82c.mp3","duration":2.368,"speaker":"voice","envelope":[0.038,0.702,1,0.936,0.423,1,1,0.762,0.233,0.404,1,1,0.954,0.609,0.482,0.328,0.114,0.17,0.154,0.618,0.564,0.545,0.742,0.914,0.847,0.801,0.764,0.666,0.454,0.14,0.021,0.181,0.935,0.66,0.296,0.127,0.137,0.221,0.143,0.016,0.051,0.007,0.004,0.005,0.004,0.004,0.002,0.001],"speechHash":"aa48a83b9db3583e908dfb67f8466fcd723d04ac967db95bdc1394ed2c6783fa","text":"Where he hides what he knows best."},"room_voicenote-4":{"url":"/assets/audio/voices/1c2b3367-a3da9de0e6.mp3","duration":2.539,"speaker":"voice","envelope":[0.042,0.824,0.509,0.69,1,1,1,1,1,0.981,0.87,0.706,0.563,0.142,0.108,0.364,1,0.873,0.522,0.395,0.233,0.065,0.075,0.45,0.405,0.078,0.297,0.602,0.679,0.717,0.724,0.904,0.256,0.407,0.326,0.166,0.335,0.383,0.52,0.522,0.323,0.182,0.053,0.058,0.007,0.004,0.004,0.004,0.003,0.003,0.002],"speechHash":"0b63e45d7e1ec5dd3f4ee24ebf9fade8dc6882863695a83775ec2f1123909fc3","text":"The room may hold what he never said,"},"room_voicenote-5":{"url":"/assets/audio/voices/77003a7d-c5ea151dc6.mp3","duration":2.389,"speaker":"voice","envelope":[0.163,0.588,0.021,0.385,0.347,0.506,1,1,1,0.453,0.051,0.129,0.166,0.065,1,1,0.882,0.989,0.887,0.652,0.61,0.796,0.713,0.418,0.141,0.064,0.023,0.158,0.049,0.45,0.598,0.624,0.521,0.551,0.62,0.517,0.349,0.245,0.114,0.06,0.064,0.013,0.005,0.004,0.005,0.004,0.003,0.001],"speechHash":"5e42ca319019e14c6d05bd3edf883c9ca518684f37ec3ff02ca03a5bd187bdda","text":"A truth better left unread."},"room_voicenote-6":{"url":"/assets/audio/voices/b010ac92-0acfa5f105.mp3","duration":2.674,"speaker":"voice","speechHash":"ef7745ac3c1df373c53936f322cb0e93246c14912aa26042cdd7ae08d1a1f88c","envelope":[0.064,0.272,0.876,1,1,0.461,0.2,0.304,0.597,1,1,1,0.323,0.037,0.121,0.642,1,0.98,0.203,0.083,0.486,0.436,0.39,0.27