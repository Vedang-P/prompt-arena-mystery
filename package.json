{
  "name": "prompt-arena-mystery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt Arena: Mystery — live AI-interrogation whodunit for 70 teams on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute DB --remote --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
