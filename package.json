{
  "name": "prompt-arena-mystery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt Arena: Mystery — live AI-interrogation whodunit for 70 teams on Cloudflare Workers + D1",
  "scripts": {
    "build:case": "node scripts/build-case.mjs",
    "validate:case": "node scripts/build-case.mjs --check",
    "test:engine": "npm run build:case && node scripts/test-engine.mjs",
    "gen:team": "node scripts/make-team.mjs",
    "import:mixamo": "blender --background --python scripts/blender/import_mixamo.py",
    "dev": "npm run build:case && wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:case && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute DB --local --file=./schema.sql && wrangler d1 execute DB --local --file=./seed.sql",
    "db:remote": "wrangler d1 execute DB --remote --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "hono": "^4.6.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "19.2",
    "react-dom": "19.2",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0",
    "yaml": "^2.6.0"
  }
}
