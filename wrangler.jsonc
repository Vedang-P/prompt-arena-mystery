{
  // prompt-arena-mystery — Worker API + static client + D1
  "name": "prompt-arena-mystery",
  "main": "src/worker.js",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prompt-arena-mystery-db",
      // replace with the id from: npx wrangler d1 create prompt-arena-mystery-db
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
